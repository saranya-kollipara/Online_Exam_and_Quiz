# Quentrix AI Backend - Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database URL (Prisma format)
# Standard format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/quentrix_ai"

# JWT Authentication
JWT_SECRET="quentrix_super_secret_jwt_key_2026_academic_engine_#99"
JWT_EXPIRES_IN="7d"

# Frontend Client URL (for CORS and Socket.io)
CLIENT_URL="http://localhost:5173"

# Admin Setup Secret (Used for secure initial admin creation if needed)
ADMIN_SETUP_SECRET="quentrix_admin_secure_provisioning_key_2026"

# AI Service Configuration
# AI_PROVIDER can be 'gemini' or 'openai' or 'mock'
AI_PROVIDER="gemini"
AI_API_KEY="your_gemini_or_openai_api_key_here"
AI_MODEL="gemini-1.5-flash"

# Judge0 Code Execution API
# Free public Judge0 CE or RapidAPI endpoint
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
JUDGE0_TIMEOUT_SECONDS=5

